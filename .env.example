# Copy to .env. Never commit .env.
# LLM (OpenRouter, OpenAI-compatible). Test mode never calls the model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5
# Discord webhook for trace headlines (best-effort; failures are logged, never fatal)
DISCORD_WEBHOOK_URL=
# Salesforce: auth is the Salesforce CLI refresh token. Run once: sf org login web --alias dev
SF_CLI_ALIAS=dev
SF_API_VERSION=67.0
# Airtable personal access token with data.records:read/write + schema.bases:read/write, and the base id (app...)
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
# OffBoard API keys. Prefix decides the mode: sk_test_* -> mocks + cassettes, sk_live_* -> real systems.
OFFBOARD_TEST_KEY=sk_test_offboard_demo
OFFBOARD_LIVE_KEY=sk_live_offboard_demo
# Optional: Browserbase second-witness (block 9)
BROWSERBASE_API_KEY=
