  "rules": [
    {
      "id": "03dg7000002ptSjAAI",
      "object": "Opportunity",
      "name": "ClosedLost_Requires_Reason",
      "active": true,
      "formula": "ISPICKVAL(StageName,\"Closed Lost\") && ISBLANK(Loss_Reason__c)",
      "error_message": "Enter a loss reason before closing as lost.",
      "error_display_field": "Loss Reason",
      "description": "Sales ops: win/loss analysis needs a reason on every lost deal."
    },
    {
      "id": "03dg7000002ptPVAAY",
      "object": "Opportunity",
      "name": "ClosedWon_Amount_Naive",
      "active": true,
      "formula": "ISPICKVAL(StageName,\"Closed Won\") && Amount <= 0",
      "error_message": "A Closed Won opportunity must have a positive amount.",
      "error_display_field": "Amount",
      "description": "Finance: no deal may be booked as won with zero or negative revenue."
    },
    {
      "id": "03dg7000002ptR7AAI",
      "object": "Opportunity",
      "name": "ClosedWon_Requires_Amount",
      "active": true,
      "formula": "ISPICKVAL(StageName,\"Closed Won\") && (ISBLANK(Amount) || Amount <= 0)",
      "error_message": "A Closed Won opportunity must have a positive amount.",
      "error_display_field": "Amount",
      "description": "Finance: revenue recognition depends on every won deal carrying a real amount."
    },
    {
      "id": "03dg7000002puAHAAY",
      "object": "Opportunity",
      "name": "Discount_Cap",
      "active": true,
      "formula": "Discount__c > 50",
      "error_message": "Discounts above 50% require a separate approval; enter 50 or less.",
      "error_display_field": "Discount",
      "description": "Finance policy: maximum self-serve discount is 50 percent."
    },
    {
      "id": "03dg7000002pua5AAA",
      "object": "Opportunity",
      "name": "EMEA_Requires_Amount",
      "active": true,
      "formula": "ISPICKVAL(Region__c,\"EMEA\") && ISBLANK(Amount)",
      "error_message": "EMEA opportunities must carry an amount at creation.",
      "error_display_field": "Amount",
      "description": "EMEA partner routing needs an amount at creation to pick the partner tier."
    },
    {
      "id": "03dg7000002ptfdAAA",
      "object": "Opportunity",
      "name": "Large_Deal_Type_Guard",
      "active": true,
      "formula": "Amount > 1000000 && NOT(ISPICKVAL(Type,\"New Customer\"))",
      "error_message": "Deals over $1M must be typed as New Customer for exec review.",
      "error_display_field": "Type",
      "description": "Exec review: every seven-figure deal is routed as new business regardless of account history."
    },
    {
      "id": "03dg7000002ptZBAAY",
      "object": "Opportunity",
      "name": "Negotiation_Min_Probability",
      "active": true,
      "formula": "ISPICKVAL(StageName,\"Negotiation/Review\") && Probability < 50",
      "error_message": "Deals in Negotiation/Review must have probability of at least 50%.",
      "error_display_field": "Probability (%)",
      "description": "Forecasting: negotiation-stage deals below 50% distort the weighted pipeline."
    },
    {
      "id": "03dg7000002pqcwAAA",
      "object": "Opportunity",
      "name": "Stage_Regression_Blocked",
      "active": true,
      "formula": "ISPICKVAL(PRIORVALUE(StageName),\"Closed Won\") && NOT(ISPICKVAL(StageName,\"Closed Won\"))",
      "error_message": "A Closed Won opportunity cannot be reopened; clone it instead.",
      "error_display_field": "Stage",
      "description": "Revenue integrity: booked deals are immutable; a reopened deal must be cloned instead."
    }
  ]
